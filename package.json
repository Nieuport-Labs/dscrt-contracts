{
  "name": "dscrt-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Liquid staking contracts for SCRT on Secret Network",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nieuport-Labs/dscrt-contracts.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "tests/e2e"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:unit": "cargo test --workspace",
    "test:e2e": "node --test tests/e2e/src/protocol.test.mjs",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all -- --check",
    "devnet:up": "node scripts/devnet.mjs up",
    "devnet:down": "node scripts/devnet.mjs down",
    "check": "npm run fmt:check && npm run lint:rust && npm run test:unit"
  },
  "devDependencies": {
    "secretjs": "^1.22.1"
  }
}
